# =============================================================
# Backend-specific .gitignore
# (Root .gitignore handles most rules — this is supplementary)
# =============================================================

# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyc

# Environment secrets
.env

# Uploaded runtime files (keep folder, ignore contents)
uploads/*
!uploads/.gitkeep

# Vector / DB files generated at runtime
*.faiss
*.pkl
chroma_db/
vector_store/
*.db
*.sqlite

# Test cache
.pytest_cache/
.coverage
htmlcov/